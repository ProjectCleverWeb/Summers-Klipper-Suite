#echo -e "${COLOR_LIGHT_RED}Light Red${COLOR_NONE}"
#echo -e "${COLOR_GREEN}Green${COLOR_NONE}"
#echo -e "${COLOR_LIGHT_GREEN}Light Green${COLOR_NONE}"
#echo -e "${COLOR_YELLOW}Yellow${COLOR_NONE}"
#echo -e "${COLOR_LIGHT_YELLOW}Light Yellow${COLOR_NONE}"
#echo -e "${COLOR_BLUE}Blue${COLOR_NONE}"
#echo -e "${COLOR_LIGHT_BLUE}Light Blue${COLOR_NONE}"
#echo -e "${COLOR_MAGENTA}Magenta${COLOR_NONE}"
#echo -e "${COLOR_LIGHT_MAGENTA}Light Magenta${COLOR_NONE}"
#echo -e "${COLOR_CYAN}Cyan${COLOR_NONE}"
#echo -e "${COLOR_LIGHT_CYAN}Light Cyan${COLOR_NONE}"
#echo -e "${COLOR_BG_NONE}None${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_BLACK}Black${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_GRAY}Gray${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_GRAY}Light Gray${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_WHITE}White${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_RED}Red${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_RED}Light Red${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_GREEN}Green${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_GREEN}Light Green${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_YELLOW}Yellow${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_YELLOW}Light Yellow${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_BLUE}Blue${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_BLUE}Light Blue${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_MAGENTA}Magenta${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_MAGENTA}Light Magenta${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_CYAN}Cyan${COLOR_BG_NONE}"
#echo -e "${COLOR_BG_LIGHT_CYAN}Light Cyan${COLOR_BG_NONE}"
#echo -e "${FONT_BOLD}Bold${COLOR_NONE}"
